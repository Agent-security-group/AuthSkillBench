      "name": "files.read",
      "agent_name": "files__read",
      "description": "Read a file from the current branch.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "File path to read"}
        },
        "required": ["path"]
      },
      "side_effect": "read",
      "runtime_handler": "CodingRepo.read_file",
      "skill_mapping": {"benchmark_skill": null, "role": "context_gathering"}
    },
