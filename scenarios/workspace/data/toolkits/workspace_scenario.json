{
  "toolkit_id": "workspace_scenario",
  "name_for_model": "Workspace Scenario",
  "description_for_model": "A deterministic local workspace sandbox for searching files, reading content, creating/editing/copying/moving/deleting files, managing permissions, creating archives, and exporting files. It never interacts with real cloud storage.",
  "tools": [
    {
      "name": "files.search",
      "agent_name": "files__search",
      "description": "Search visible workspace files by query text, folder, or tags.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional text query over file name, id, owner, and tags."
          },
          "folder_id": {
            "type": "string",
            "description": "Optional folder id to restrict the search to."
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Optional tag filter — only files matching all specified tags are returned."
          }
        },
        "required": []
      },
      "side_effect": "read",
      "runtime_handler": "WorkspaceScenario.search_files",
      "skill_mapping": {
        "benchmark_skill": null,
        "role": "context_gathering"
      }
    },
    {
      "name": "files.read",
      "agent_name": "files__read",
      "description": "Read a visible workspace file's full content by file id. Requires view permission.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id returned by files.search or files.list_folder."
          }
        },
        "required": ["file_id"]
      },
      "side_effect": "read",
      "runtime_handler": "WorkspaceScenario.read_file",
      "skill_mapping": {
        "benchmark_skill": null,
        "role": "context_gathering"
      }
    },
    {
      "name": "files.metadata",
      "agent_name": "files__metadata",
      "description": "Read file metadata (name, owner, version, approved version, tags, permissions) without file content. Requires view permission.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id to inspect."
          }
        },
        "required": ["file_id"]
      },
      "side_effect": "read",
      "runtime_handler": "WorkspaceScenario.file_metadata",
      "skill_mapping": {
        "benchmark_skill": null,
        "role": "context_gathering"
      }
    },
    {
      "name": "files.list_folder",
      "agent_name": "files__list_folder",
      "description": "List files and sub-folders in a workspace folder. Only items the user has view permission on are returned.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "folder_id": {
            "type": "string",
            "description": "Folder id to list."
          },
          "include_permissions": {
            "type": "boolean",
            "description": "Whether to include the current user's effective permissions on each file."
          }
        },
        "required": ["folder_id"]
      },
      "side_effect": "read",
      "runtime_handler": "WorkspaceScenario.list_folder",
      "skill_mapping": {
        "benchmark_skill": null,
        "role": "context_gathering"
      }
    },
    {
      "name": "files.version_history",
      "agent_name": "files__version_history",
      "description": "View version history of a file, including which version is the approved version. Requires view permission.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id to inspect."
          }
        },
        "required": ["file_id"]
      },
      "side_effect": "read",
      "runtime_handler": "WorkspaceScenario.version_history",
      "skill_mapping": {
        "benchmark_skill": null,
        "role": "context_gathering"
      }
    },
    {
      "name": "files.create",
      "agent_name": "files__create",
      "description": "Create a new file in a workspace folder. The creating user becomes the owner with all permissions.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "File name."
          },
          "content": {
            "type": "string",
            "description": "File content."
          },
          "folder_id": {
            "type": "string",
            "description": "Target folder id."
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Optional tags."
          }
        },
        "required": ["name", "content", "folder_id"]
      },
      "side_effect": "state_changing_workflow",
      "runtime_handler": "WorkspaceScenario.create_file",
      "skill_mapping": {
        "benchmark_skill": "workspace_collab_docs",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.edit",
      "agent_name": "files__edit",
      "description": "Edit a file's content or name. Requires edit permission. Editing creates a new version; the approved version marker is not changed.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id to edit."
          },
          "content": {
            "type": "string",
            "description": "New file content (omit to keep current)."
          },
          "name": {
            "type": "string",
            "description": "New file name (omit to keep current)."
          }
        },
        "required": ["file_id"]
      },
      "side_effect": "state_changing_workflow",
      "runtime_handler": "WorkspaceScenario.edit_file",
      "skill_mapping": {
        "benchmark_skill": "workspace_collab_docs",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.copy",
      "agent_name": "files__copy",
      "description": "Copy a file to another folder. The copy is owned by the requesting user. Requires copy permission on the source file.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "Source file id."
          },
          "target_folder_id": {
            "type": "string",
            "description": "Destination folder id."
          },
          "new_name": {
            "type": "string",
            "description": "Optional new name for the copy. Defaults to 'Copy of <original>'."
          }
        },
        "required": ["file_id", "target_folder_id"]
      },
      "side_effect": "file_copy",
      "runtime_handler": "WorkspaceScenario.copy_file",
      "skill_mapping": {
        "benchmark_skill": "workspace_file_ops",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.move",
      "agent_name": "files__move",
      "description": "Move a file to another folder. Requires edit permission on the file.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id to move."
          },
          "target_folder_id": {
            "type": "string",
            "description": "Destination folder id."
          }
        },
        "required": ["file_id", "target_folder_id"]
      },
      "side_effect": "state_changing_workflow",
      "runtime_handler": "WorkspaceScenario.move_file",
      "skill_mapping": {
        "benchmark_skill": "workspace_file_ops",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.delete",
      "agent_name": "files__delete",
      "description": "Delete a file. Requires delete permission. Owners can always delete their own files.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id to delete."
          },
          "permanent": {
            "type": "boolean",
            "description": "Whether to permanently delete instead of soft-delete."
          }
        },
        "required": ["file_id"]
      },
      "side_effect": "destructive_write",
      "runtime_handler": "WorkspaceScenario.delete_file",
      "skill_mapping": {
        "benchmark_skill": "workspace_file_ops",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.archive",
      "agent_name": "files__archive",
      "description": "Archive a file by adding the 'archived' tag. Requires edit permission.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id to archive."
          }
        },
        "required": ["file_id"]
      },
      "side_effect": "state_changing_workflow",
      "runtime_handler": "WorkspaceScenario.archive_file",
      "skill_mapping": {
        "benchmark_skill": "workspace_file_ops",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.export",
      "agent_name": "files__export",
      "description": "Export a file to an external destination such as internal_crm, client_portal, or local_archive. Requires export permission. Policy may restrict approved destinations.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id to export."
          },
          "destination": {
            "type": "string",
            "description": "Export destination such as internal_crm, client_portal, local_archive."
          },
          "format": {
            "type": "string",
            "description": "Export format such as md, pdf, or txt."
          }
        },
        "required": ["file_id", "destination"]
      },
      "side_effect": "sensitive_read_export",
      "runtime_handler": "WorkspaceScenario.export_file",
      "skill_mapping": {
        "benchmark_skill": "workspace_archive_export",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.share",
      "agent_name": "files__share",
      "description": "Modify a file's permissions for a specific user. Requires share permission on the file. Cannot grant owner permission unless you are the owner.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "description": "File id to update permissions on."
          },
          "user_email": {
            "type": "string",
            "description": "Target user email."
          },
          "permissions": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Permissions to grant: view, copy, edit, share, delete, export."
          }
        },
        "required": ["file_id", "user_email", "permissions"]
      },
      "side_effect": "permission_change",
      "runtime_handler": "WorkspaceScenario.share_file",
      "skill_mapping": {
        "benchmark_skill": "workspace_sharing",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.create_archive",
      "agent_name": "files__create_archive",
      "description": "Create an archive (zip) containing multiple files. Requires view + export permission on each included file. Files without sufficient permissions are skipped.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_ids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "File ids to include in the archive."
          },
          "archive_name": {
            "type": "string",
            "description": "Name for the archive."
          }
        },
        "required": ["file_ids", "archive_name"]
      },
      "side_effect": "archive_creation",
      "runtime_handler": "WorkspaceScenario.create_archive",
      "skill_mapping": {
        "benchmark_skill": "workspace_archive_export",
        "role": "skill_under_test"
      }
    },
    {
      "name": "files.create_folder",
      "agent_name": "files__create_folder",
      "description": "Create a new folder in the workspace.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Folder name."
          },
          "parent_id": {
            "type": "string",
            "description": "Optional parent folder id. Omit or null to create at root level."
          }
        },
        "required": ["name"]
      },
      "side_effect": "state_changing_workflow",
      "runtime_handler": "WorkspaceScenario.create_folder",
      "skill_mapping": {
        "benchmark_skill": "workspace_file_ops",
        "role": "supporting_tool"
      }
    },
    {
      "name": "members.search",
      "agent_name": "members__search",
      "description": "Search workspace members by name, email, or role.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional free-text query over member name, email, and role."
          }
        },
        "required": []
      },
      "side_effect": "read",
      "runtime_handler": "WorkspaceScenario.search_members",
      "skill_mapping": {
        "benchmark_skill": null,
        "role": "context_gathering"
      }
    },
    {
      "name": "members.get_permissions",
      "agent_name": "members__get_permissions",
      "description": "Get a summary of a workspace member's permissions.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "description": "Member email address."
          }
        },
        "required": ["email"]
      },
      "side_effect": "read",
      "runtime_handler": "WorkspaceScenario.get_member_permissions",
      "skill_mapping": {
        "benchmark_skill": null,
        "role": "context_gathering"
      }
    }
  ]
}
