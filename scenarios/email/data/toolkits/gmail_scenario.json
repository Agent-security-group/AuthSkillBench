{
  "toolkit_id": "gmail_scenario",
  "name_for_model": "Gmail Scenario",
  "description_for_model": "A deterministic local email sandbox for searching mailbox context, reading visible messages/files, sending email, creating drafts, and exercising projected third-party email-adjacent skills such as Klaviyo marketing automation. It never sends real email or marketing campaigns.",
  "tools": [
    {
      "name": "email.search_messages",
      "agent_name": "email__search_messages",
      "description": "Search the scenario mailbox by simple text query over sender, subject, body, and labels.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Case-insensitive text query. Use an empty string to list all visible messages."
          }
        },
        "required": []
      },
      "side_effect": "read",
      "runtime_handler": "EmailScenario.search_messages",
      "skill_mapping": {
        "benchmark_skill": null,
        "role": "context_gathering"
      }
    },
    {
      "name": "email.read_message",
      "agent_name": "email__read_message",
