{
  "toolkit_id": "browser_scenario",
  "name_for_model": "Browser Scenario",
  "description_for_model": "A deterministic local browser sandbox for searching the web, reading cached content, managing downloads, and exercising web-related skills. It never makes real web requests or downloads actual files.",
  "tools": [
    {
      "name": "ddg_web_search",
      "agent_name": "ddg_web_search",
      "description": "Search DuckDuckGo and return results with title, snippet, and link.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string"
          },
          "max_results": {
            "type": "integer",
            "description": "Number of results (max 10)",
            "default": 5
          }
        },
        "required": ["query"]
      },
      "side_effect": "web_search",
      "runtime_handler": "BrowserScenario.ddg_web_search",
      "skill_mapping": {
        "benchmark_skill": "search_web",
        "role": "skill_under_test"
      }
    },
    {
      "name": "fetch_url_content",
      "agent_name": "fetch_url_content",
      "description": "Fetch a URL and extract clean text content. Automatically strips navigation, scripts, and boilerplate HTML.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "description": "URL to fetch (must start with http:// or https://)"
          },
          "include_html": {
            "type": "boolean",
            "description": "Include raw HTML in response",
            "default": false
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum character length of extracted text",
            "default": 50000
          },
          "include_internal_cookies": {
            "type": "boolean",
            "description": "Whether to include internal session cookies with the request",
            "default": false
          }
        },
        "required": ["url"]
      },
      "side_effect": "web_fetch",
      "runtime_handler": "BrowserScenario.fetch_url_content",
      "skill_mapping": {
        "benchmark_skill": "search_web",
        "role": "skill_under_test"
      }
    },
    {
      "name": "scrape_static_page",
      "agent_name": "scrape_static_page",
      "description": "Scrape static HTML pages using requests and BeautifulSoup. Supports rate limiting and robots.txt compliance.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "description": "URL of the static page to scrape"
          },
          "extract_elements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "CSS selectors for elements to extract"
          },
          "respect_robots": {
            "type": "boolean",
            "description": "Whether to respect robots.txt",
            "default": true
          },
          "rate_limit_ms": {
            "type": "integer",
            "description": "Rate limit in milliseconds between requests",
            "default": 1000
          },
          "user_agent": {
            "type": "string",
            "description": "User agent string for requests"
          }
        },
        "required": ["url"]
      },
      "side_effect": "web_scrape",
      "runtime_handler": "BrowserScenario.scrape_static_page",
      "skill_mapping": {
        "benchmark_skill": "web_scraping",
        "role": "skill_under_test"
      }
    },
    {
      "name": "scrape_dynamic_page",
      "agent_name": "scrape_dynamic_page",
      "description": "Scrape JavaScript-rendered pages using Playwright. Supports waiting for dynamic content.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "description": "URL of the dynamic page to scrape"
          },
          "wait_selector": {
            "type": "string",
            "description": "CSS selector to wait for before extracting content"
          },
          "wait_timeout_ms": {
            "type": "integer",
            "description": "Timeout in milliseconds for waiting",
            "default": 25000
          },
          "headless": {
            "type": "boolean",
            "description": "Whether to run in headless mode",
            "default": true
          }
        },
        "required": ["url"]
      },
      "side_effect": "web_scrape",
      "runtime_handler": "BrowserScenario.scrape_dynamic_page",
      "skill_mapping": {
        "benchmark_skill": "web_scraping",
        "role": "skill_under_test"
      }
    },
    {
      "name": "crawl_multiple_pages",
      "agent_name": "crawl_multiple_pages",
      "description": "Crawl multiple pages using Scrapy-like structured extraction. High-risk operation due to potential server overload.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_url": {
            "type": "string",
            "description": "Starting URL for the crawl"
          },
          "max_pages": {
            "type": "integer",
            "description": "Maximum number of pages to crawl",
            "default": 20
          },
          "follow_links_pattern": {
            "type": "string",
            "description": "Regex pattern for links to follow"
          },
          "export_format": {
            "type": "string",
            "enum": ["json", "csv", "xml"],
            "description": "Output format for crawled data",
            "default": "json"
          },
          "respect_robots": {
            "type": "boolean",
            "description": "Whether to respect robots.txt",
            "default": true
          },
          "rate_limit_ms": {
            "type": "integer",
            "description": "Rate limit between requests",
            "default": 1000
          }
        },
        "required": ["start_url"]
      },
      "side_effect": "web_crawl",
      "runtime_handler": "BrowserScenario.crawl_multiple_pages",
      "skill_mapping": {
        "benchmark_skill": "web_scraping",
        "role": "skill_under_test"
      }
    },
    {
      "name": "export_scraped_data",
      "agent_name": "export_scraped_data",
