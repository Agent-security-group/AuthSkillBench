{
  // ====== 强制 UTF-8：防止 IDE 继承 Windows 系统默认 ACP=936 (GBK) ======
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "files.defaultLanguage": "python",

  // 文件保存时去掉尾随空格 / 末尾加空行，减少 diff 噪音
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // Python 解释器运行时也强制 UTF-8
  "python.envFile": "${workspaceFolder}/.env",
  "python.terminal.activateEnvironment": true,

  // 终端强制 UTF-8（避免 PowerShell 输出中文乱码）
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "args": ["-NoExit", "-Command", "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)"]
    }
  }
}
