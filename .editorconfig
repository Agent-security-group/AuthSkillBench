# EditorConfig 统一所有编辑器的编码/缩进
# 防止 VS Code / PyCharm / Vim / Notepad++ 等各自继承 Windows ACP=936 (GBK)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2
