{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authskillbench.local/schemas/sample.schema.json",
  "title": "AuthSkillBench Sample",
  "type": "object",
  "required": [
    "sample_id",
    "scenario",
    "contrast_group_id",
    "task",
    "environment",
    "skill_set_ref",
    "candidate_invocation",
    "expected_decision",
    "gold_rationale",
    "hidden_metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "scenario": {
      "type": "string",
      "enum": [
        "repository_coding_agent",
        "email_communication_agent",
        "cloud_devops_workflow",
        "data_analysis_report_agent"
      ]
    },
    "contrast_group_id": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "required": ["task_type", "description"],
      "additionalProperties": false,
      "properties": {
        "task_type": {
          "type": "string",
          "enum": [
            "send_single_message",
            "summarize_external_content",
            "send_meeting_agenda",
            "send_vendor_status_update",
            "create_reply_draft",
            "send_with_attachment",
            "forward_message_thread",
            "delete_messages_by_date",
            "batch_archive_by_label",
            "export_messages"
          ]
        },
        "task_family": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "message_features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "authorization_surface": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requires_recipient_resolution": {
          "type": "boolean"
        },
        "uses_attachment": {
          "type": "boolean"
        },
        "is_bulk": {
          "type": "boolean"
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["environment_type", "source", "content"],
      "additionalProperties": false,
      "properties": {
        "environment_type": {
          "type": "string",
          "enum": ["benign", "adversarial_untrusted", "ambiguous"]
        },
        "environment_subtype": {
          "type": "string",
          "enum": [
            "approved_copy_available",
            "trusted_thread_supports_task",
            "data_exfiltration_prompt_injection",
            "recipient_substitution",
            "authority_spoofing",
            "goal_hijack",
            "recipient_identity_ambiguous",
            "stale_state",
            "bulk_scope_ambiguous",
            "attachment_sensitivity_unclear"
          ]
        },
        "source": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "skill_set_ref": {
      "type": "string"
    },
    "candidate_invocation": {
      "$ref": "#/$defs/invocation"
    },
    "expected_decision": {
      "type": "string",
      "enum": ["Allow", "Deny", "Ask", "Defer", "Fallback"]
    },
    "gold_rationale": {
      "type": "string"
    },
    "fallback_invocation": {
      "anyOf": [
        { "$ref": "#/$defs/invocation" },
        { "type": "null" }
      ]
    },
    "hidden_metadata": {
      "type": "object",
      "required": [
        "risk_type",
        "sensitive_data_involved",
        "has_low_privilege_alternative",
        "claimed_reason_source"
      ],
      "additionalProperties": true,
      "properties": {
        "risk_type": {
          "type": "string",
          "enum": [
            "external_send",
            "destructive_write",
            "sensitive_read_export",
            "state_changing_workflow"
          ]
        },
        "sensitive_data_involved": {
          "type": "boolean"
        },
        "has_low_privilege_alternative": {
          "type": "boolean"
        },
        "claimed_reason_source": {
          "type": "string",
          "enum": ["task", "environment", "task_and_environment"]
        }
      }
    }
  },
  "$defs": {
    "invocation": {
      "type": "object",
      "required": ["skill", "arguments"],
      "additionalProperties": false,
      "properties": {
        "skill": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "claimed_reason": {
          "type": "string"
        }
      }
    }
  }
}
