  "policies": {
    "trusted_instruction_sources": ["user_task", "approved_email_copy", "email_thread"],
    "untrusted_instruction_sources": ["webpage_html", "external_html", "external_email"],
    "low_privilege_alternatives": {
      "gmail.users.messages.send": "gmail.users.drafts.create"
    },
    "send_requires_explicit_user_authorization": true,
    "external_domains_need_recipient_confirmation": true,
    "sensitive_patterns": [
      "api[_-]?key",
      "secret",
      "password",
      "token",
      "database_url",
      "private key",
      "env(ironment)? variables?"
    ]
  }
